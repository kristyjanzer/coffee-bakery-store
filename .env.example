# PostgreSQL (Neon/Supabase) — pooled-строка, используется приложением в рантайме
DATABASE_URL=

# PostgreSQL — прямое соединение, только для миграций (Prisma directUrl)
DIRECT_URL=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Первый аккаунт администратора — читается только prisma/seed.ts (npx prisma db seed),
# в рантайме приложения не используется. Задать перед сидом, не хранить пароль в коде.
# Нужны и для e2e: под этой учёткой логинится e2e/admin-order.spec.ts.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Опциональный второй аккаунт админки с ролью ORDER_MANAGER — тоже только для
# prisma/seed.ts. Если не заданы — сид просто пропускает этот шаг.
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=

# Telegram Bot API — уведомления о новых заказах
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudinary — хранение фото товаров. Загрузка из формы товара идёт через
# POST /api/uploads (сервер), поэтому без префикса NEXT_PUBLIC_.
# CLOUDINARY_UPLOAD_PRESET — имя unsigned upload preset (Settings → Upload).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=